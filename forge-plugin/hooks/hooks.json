{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-inject.sh",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-safety.sh",
            "async": false
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-rules-check.sh",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$FORGE_NESTED\" ] || python3 \"${CLAUDE_PLUGIN_ROOT}/voice/notify.py\" stop 2>/dev/null || { f=$(ls \"${CLAUDE_PLUGIN_ROOT}\"/sounds/stop/*.mp3 2>/dev/null | sort -R | head -1); afplay -v 0.05 \"$f\" 2>/dev/null || paplay --volume 3277 \"$f\" 2>/dev/null || true; }",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$FORGE_NESTED\" ] || python3 \"${CLAUDE_PLUGIN_ROOT}/voice/notify.py\" permission 2>/dev/null || { f=$(ls \"${CLAUDE_PLUGIN_ROOT}\"/sounds/permission/*.mp3 2>/dev/null | sort -R | head -1); afplay -v 0.05 \"$f\" 2>/dev/null || paplay --volume 3277 \"$f\" 2>/dev/null || true; }",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/log-compress.sh",
            "timeout": 150,
            "async": false
          }
        ]
      }
    ]
  }
}
